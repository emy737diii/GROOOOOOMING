# База данных PostgreSQL
DATABASE_URL=postgres://grooming:password@localhost:5432/grooming

# Адрес сайта без слеша в конце (нужен для sitemap и Telegram)
SITE_URL=https://example.ru

# Часовой пояс салона (время визита на странице клиента)
SALON_TIMEZONE=Europe/Moscow

# Случайная строка минимум 32 символа: openssl rand -hex 32
SESSION_SECRET=
IP_HASH_SALT=

# Вход владельца. Если ADMIN_PASSWORD пустой, пароль сгенерируется и покажется один раз при npm run db:migrate
ADMIN_LOGIN=owner
ADMIN_PASSWORD=

# Telegram-бот салона (создаётся через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Случайная строка из латиницы и цифр: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
